# Copy to .env ON THE SERVER ONLY. Never commit .env, never paste these values into chats.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Project Settings -> API Keys -> secret / service_role key (bypasses RLS: treat like a root password)
SUPABASE_SERVICE_ROLE_KEY=

# Competitor addresses are kept out of the public repo:
MANDARIN_URL=
SAFO_SITE_URL=
HIKMAT_SITE_URL=
UMRA_UZ_URL=

# Safar Travel: OUR OWN agent login to their dashboard (dashboard.safartravel.uz), sent as
# HTTP Basic Auth to its backing API. Not a public scrape; keep these only in .env on the server.
SAFAR_TRAVEL_API_URL=
SAFAR_TRAVEL_USER=
SAFAR_TRAVEL_PASS=

# Our own partner API (ETIHAD). The key is a secret: .env only.
ETIHAD_API_URL=
ETIHAD_API_KEY=

# Telegram (Phase 4). Use a NEW dedicated bot (not the pilgrim or support bots). The token lives only here.
TELEGRAM_BOT_TOKEN=
# Fallback only: the admin normally sets the chat in the database (app_settings key 'telegram').
# TELEGRAM_CHAT_ID=
