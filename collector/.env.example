# Copy to .env ON THE SERVER ONLY. Never commit .env, never paste these values into chats.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Project Settings -> API Keys -> secret / service_role key (bypasses RLS: treat like a root password)
SUPABASE_SERVICE_ROLE_KEY=

# Competitor addresses are kept out of the public repo:
MANDARIN_URL=
SAFO_SITE_URL=

# Telegram (Phase 4). Use a NEW dedicated bot (not the pilgrim or support bots). The token lives only here.
TELEGRAM_BOT_TOKEN=
# Fallback only: the admin normally sets the chat in the database (app_settings key 'telegram').
# TELEGRAM_CHAT_ID=
