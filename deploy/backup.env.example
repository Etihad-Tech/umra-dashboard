# Copy to deploy/backup.env ON THE SERVER and chmod 600. Never commit it (.gitignore covers it).
# Values: Supabase dashboard -> Connect -> "Session pooler" (works over IPv4; the direct db.<ref>.supabase.co
# host is IPv6-only and most VPS have no IPv6). Plain KEY=value lines: no quotes, no spaces around "=".
# The password is read by pg_dump from the environment, never from the command line. SSL is always required.
PGHOST=aws-0-YOUR-REGION.pooler.supabase.com
PGPORT=5432
PGUSER=postgres.YOUR-PROJECT-REF
PGPASSWORD=YOUR-DATABASE-PASSWORD
PGDATABASE=postgres
