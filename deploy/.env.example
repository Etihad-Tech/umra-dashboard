# Copy to deploy/.env ON THE SERVER. Only PUBLIC values here: the website's address and the PUBLIC (publishable/anon) key.
# SITE_DOMAIN: the name nginx answers to and certbot gets the certificate for. A real (sub)domain with an A record,
# or with no DNS at all: <word>-<random>.<server-ip>.sslip.io
SITE_DOMAIN=prices.example.com
# WEB_PORT: the loopback port nginx proxies to (127.0.0.1 only); pick one no other app on the server uses
WEB_PORT=8744
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=sb_publishable_...
